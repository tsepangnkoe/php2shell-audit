  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node bin/php2shell-audit.js"
  },
  "engines": {
    "node": ">=18"
  },
